{
  "name": "@petbattle/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PetBattle 纯 TS 领域核心：只能被引用，不依赖 Cocos/微信/DOM/网络/时钟/随机源。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  }
}
